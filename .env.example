# ── โหมดการทำงาน ─────────────────────────────────────────────────────────────
APP_MODE=demo                # demo | hosxp
HOSPITAL_NAME=โรงพยาบาลพลับพลาชัย
JWT_SECRET=                  # สุ่มอย่างน้อย 32 ตัวอักษร เช่น: openssl rand -hex 32
COOKIE_SECURE=false          # true ถ้าเปิดผ่าน HTTPS

# ── HOSxP (อ่านอย่างเดียว) ──────────────────────────────────────────────────
HOSXP_DB_HOST=
HOSXP_DB_PORT=3306
HOSXP_DB_USER=               # user อ่านอย่างเดียว (docs/sql/create_readonly_user.sql), แนะนำต่อ Slave/Replica
HOSXP_DB_PASSWORD=
HOSXP_DB_NAME=
HOSXP_DB_CHARSET=tis620      # tis620 หรือ latin1 (ระบบแปลงภาษาไทยให้)

# ── ฐานข้อมูลของแอปเอง (แยกจาก HOSxP) ────────────────────────────────────────
APP_DB_URL=                  # mysql://user:pass@host:3306/ipd_summary — โหมด hosxp ต้องตั้ง
APP_DB_FILE=.data/appdb.json # ใช้เมื่อไม่ได้ตั้ง APP_DB_URL (เฉพาะโหมด demo)

REDIS_URL=                   # redis://localhost:6379 (ไม่ตั้งก็ได้ = ไม่มี cache)

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini           # gemini | rules
GEMINI_API_KEY=
GEMINI_MODEL=                # ให้ผู้ใช้กำหนด ห้าม hardcode ชื่อรุ่นในโค้ด
GEMINI_PAID_TIER=false       # ต้องเป็น true ถึงจะส่งข้อมูลจากโหมด hosxp ได้ (ห้ามใช้ free tier กับข้อมูลผู้ป่วย)
AI_TIMEOUT_MS=30000

NHSO_RATE_PER_ADJRW=8350     # อัตรา สปสช. 2569

# ── บัญชีทดลอง (เฉพาะโหมด demo) ─────────────────────────────────────────────
DEMO_USERNAME=demo
DEMO_PASSWORD=
