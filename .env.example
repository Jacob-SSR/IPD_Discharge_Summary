# ═════════════════════════════════════════════════════════════════════════════
# IPD Discharge Summary — ตัวอย่างค่าสำหรับใช้งานจริงคู่กับ ppc-hos-10667
# คัดลอกเป็น .env.production (Docker) หรือ .env.local (รันเอง) แล้วกรอกค่า — ห้าม commit
# ═════════════════════════════════════════════════════════════════════════════

# ── โหมดการทำงาน ─────────────────────────────────────────────────────────────
APP_MODE=hosxp               # demo | hosxp
HOSPITAL_NAME=โรงพยาบาลพลับพลาชัย
HOSPITAL_CODE=10909          # รหัสสถานพยาบาล (หัวแบบฟอร์ม)
HOSPITAL_PROVINCE=บุรีรัมย์
JWT_SECRET=                  # สุ่มใหม่ อย่างน้อย 32 ตัว: openssl rand -hex 32 (ห้ามใช้ค่าเดียวกับ ppc-hos)
COOKIE_SECURE=false          # true ถ้าเปิดผ่าน HTTPS

# ── HOSxP (อ่านอย่างเดียว) — เครื่องเดียวกับ DB_HOST ของ ppc-hos ──────────────
HOSXP_DB_HOST=               # = DB_HOST ของ ppc-hos (แนะนำ Slave/Replica)
HOSXP_DB_PORT=3306
HOSXP_DB_USER=               # user อ่านอย่างเดียว (docs/sql/create_readonly_user.sql) — ไม่ใช่ user ของ ppc-hos ที่เขียนได้
HOSXP_DB_PASSWORD=
HOSXP_DB_NAME=               # = DB_NAME ของ ppc-hos
HOSXP_DB_CHARSET=tis620      # tis620 (แบบเดียวกับ ppc-hos) หรือ latin1 (ระบบแปลงภาษาไทยให้)

# ── ฐานข้อมูลของโปรแกรม: ตารางใหม่ ipdsum_* ในฐาน ppchos (ไม่มีอยู่เดิมใน HOSxP, ไม่แตะตารางเดิม) ──
# user นี้ต้องเขียนตาราง ipdsum_* ได้ (docs/sql/create_app_user.sql) — คนละ user กับ HOSXP_DB_USER ที่อ่านอย่างเดียว
APP_DB_URL=                  # mysql://<user>:<pass>@<server ppchos>:3306/ppchos
APP_DB_FILE=.data/appdb.json # ใช้เฉพาะโหมด demo ที่ไม่ได้ตั้ง APP_DB_URL

# ── บัญชีผู้ใช้: ppchos.users ของ ppc-hos (อ่านอย่างเดียว — ชื่อ env เดียวกับ rca) ──
# คัดลอกจาก .env ของ ppc-hos: DB_HOST2 → AUTH_DB_HOST, DB_PORT → AUTH_DB_PORT, DB_USER → AUTH_DB_USER, DB_PASS → AUTH_DB_PASS
# ไม่ตั้ง AUTH_DB_HOST = อ่านตาราง APP_USERS_TABLE ผ่าน APP_DB_URL (และอัปเกรดรหัส md5 → bcrypt ตอน login แบบ ppc-hos)
AUTH_DB_HOST=
AUTH_DB_PORT=3306
AUTH_DB_USER=
AUTH_DB_PASS=
AUTH_DB_NAME=ppchos
APP_USERS_TABLE=ppchos.users # ใช้เฉพาะเมื่อไม่ได้ตั้ง AUTH_DB_HOST (อ่าน/อัปเกรดรหัสผ่านผ่าน APP_DB_URL)

# ── สิทธิ์ (role ใน ppchos.users) — หน้านี้มีข้อมูลผู้ป่วย เปิดเฉพาะคนที่เกี่ยวข้อง ──
# ใช้ username/password เดียวกับ ppc-hos — ใส่ * ถ้าให้ทุกบัญชีเข้าได้เหมือน ppc-hos
APP_ALLOWED_ROLES=DOCTOR,DIRECTOR,ADMIN,FINANCE   # หรือ *  (FINANCE = เวชระเบียน/Medical Coding)
APP_DECIDER_ROLES=DOCTOR                          # ขอคำแนะนำ AI + ยืนยัน/เพิ่มรหัสได้

REDIS_URL=                   # รันนอก Docker: redis://127.0.0.1:6379 (docker-compose.redis.yml) · ใน docker compose ตั้งให้เอง

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini           # gemini | rules
GEMINI_API_KEY=
GEMINI_MODEL=                # ให้ผู้ใช้กำหนด ห้าม hardcode ชื่อรุ่นในโค้ด
GEMINI_PAID_TIER=false       # ต้องเป็น true (เปิด billing แล้ว) ถึงจะส่งข้อมูลจากโหมด hosxp ได้
AI_TIMEOUT_MS=30000

NHSO_RATE_PER_ADJRW=8350     # อัตรา สปสช. 2569

# ── บัญชีทดลอง (เฉพาะโหมด demo) ─────────────────────────────────────────────
DEMO_USERNAME=
DEMO_PASSWORD=
